# 知识库接入服务（kb_ingest）环境变量契约
#
# 本文件是 kb_ingest 服务**唯一的**配置事实来源（P2-4）。
# 与 `kb_service/core/config.py` 一一对应：该文件通过 `os.getenv` 读取的
# 每一个变量，都必须在此声明。
#
# 一致性由 `tests/test_p35_config_governance.py` 强制：
#     config.py 读取的键 ⊆ 本文件声明的键
# 故**新增配置项时请同时更新这两处**，否则测试失败。
#
# 边界说明：kb_ingest 是**独立部署**的容器（独立 Dockerfile / requirements.txt），
# 配置边界是**环境变量**而非主应用的 settings.py——把两个部署单元的配置硬耦
# 在一起会更糟（会让接入服务依赖主应用的必需密钥）。
# 主应用的配置见仓库根目录 `.env.example`，两者**不共享**。
#
# ⚠️ 历史问题：本文件曾一度是根目录 `.env.example` 的**整份拷贝**（含 Milvus /
# Neo4j / LightRAG / CORS 等主应用专有项），对 kb_ingest 毫无意义且误导部署。
# 已按 P2-4 收敛为下述真实契约。

# ---------------------------------------------------------------------------
# 数据 IO
# ---------------------------------------------------------------------------
EXCEL_FILE_PATH=data.xlsx
OUTPUT_CSV_PATH=processed_data.csv
OUTPUT_TXT_PATH=processed_data.txt

# ---------------------------------------------------------------------------
# 文本展平（flatten）改写
# ---------------------------------------------------------------------------
USE_LLM=true
FLAT_SEPARATOR=" | "
FLAT_KV_SEPARATOR=": "
FLAT_MAX_LEN=4000

# ---------------------------------------------------------------------------
# LLM（用于结构化改写）
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
LLM_API_KEY=
LLM_BASE_URL=
# 凭据回退名（2026-10-06 完整性审查补齐：客户端会读、此前未声明）
# LLM_API_KEY 为空时的兜底（clients/llm.py、clients/embedding.py）：
# OPENAI_API_KEY=
# LLM_PROVIDER=glm 时的专用 key（clients/llm.py）：
# GLM_API_KEY=
LLM_TEMPERATURE=0.3
# LLM 调用失败时是否回退到纯规则展平（true 更稳，false 更严）
LLM_FALLBACK_TO_FLATTEN=false

# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=4096

# ---------------------------------------------------------------------------
# 批处理与重试
# ---------------------------------------------------------------------------
BATCH_SIZE=16
RETRY_TIMES=3
RETRY_DELAY=5

# ---------------------------------------------------------------------------
# Reranker（默认关闭）
# ---------------------------------------------------------------------------
RERANK_ENABLED=false
RERANK_PROVIDER=cohere
RERANK_TIMEOUT=30
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=10
# 分数融合权重；留空表示不启用融合
RERANK_SCORE_FUSION_ALPHA=0.3

# Cohere（RERANK_PROVIDER=cohere 时使用）
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_RERANK_URL=https://api.cohere.com/v2/rerank

# 自建 rerank 服务（RERANK_PROVIDER=custom 时使用）
RERANK_BASE_URL=
RERANK_ENDPOINT=/rerank
RERANK_API_KEY=
RERANK_MODEL=

# ---------------------------------------------------------------------------
# Milvus（R3.7：向量后端 = Milvus legal 集合）
#
# config.py 的读取键：MILVUS_HOST / MILVUS_PORT / MILVUS_COLLECTION。
# 部署在 compose 内时 host 用服务名 `milvus`。
# ---------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=legal

# ---------------------------------------------------------------------------
# API 鉴权（2026-09 新增；config.py 读取键：KB_REQUIRE_API_KEY / KB_API_KEY）
#
# 为什么这个服务需要鉴权：compose 把 `8100:8000` **发布到宿主机**，启动命令又是
# `uvicorn --host 0.0.0.0`，而端点是**写入**语义（Excel/MySQL 入库直接改 Milvus
# 集合）、`/api/search*` 还能把知识库读出去。四者叠加 = 同一网段内任何人可
# 无凭证改写知识库并读取全部法条语料。
#
# ⚠️ 为什么变量名**带 KB_ 前缀、不复用主应用的 API_KEY**：
# 本容器的 `env_file` 是仓库根 `.env`，若复用同一个 `API_KEY`，那么"任何拿到
# 对外 API Key 的外部客户端"就能直接调本服务的写入端点——对外凭证变成对内写
# 权限，属**权限抬升**。两者信任边界不同（主应用面向外部调用方，本服务面向
# 内部调用方 agentix），因此各用各的密钥。
#
# KB_REQUIRE_API_KEY=false（默认）时所有端点开放，但**启动期会打 WARNING**，
# 明确写出"鉴权已禁用 + 端口发布情况"，不会像此前那样无声。
# 开启后所有 /api 端点要求请求头 X-API-Key: <KB_API_KEY>；/health 保持免鉴权
# （compose healthcheck 依赖它）。
# ---------------------------------------------------------------------------
KB_REQUIRE_API_KEY=false
KB_API_KEY=

# ---------------------------------------------------------------------------
# MySQL 连接串闸门（2026-10-23 新增；config.py 读取键：KB_MYSQL_URL_GUARD /
# KB_MYSQL_ALLOWED_HOSTS；见 docs/项目实现手册.md §24.2 G12）
#
# 为什么需要：`/api/ingest/mysql` 的输入是**一整条带凭据的连接串**，服务端直接
# `create_engine(connection_url)` 去连。持本服务 key 的一方因此能把导入服务当成
# 网络代理使——`sqlite:////app/xxx.db` 读任意本地文件，`mysql://attacker:3306`
# 让服务端主动外连（内网端口探测 / 收集握手信息）。路由级 X-API-Key 只解决
# "谁能调"，不解决"调用的时候能让这台机器连哪儿"。
#
# 语义（默认关，关闭时与加固前逐位等价）：
#   KB_MYSQL_URL_GUARD=false      不校验（既有行为）
#   KB_MYSQL_URL_GUARD=true       只允许 mysql / mysql+<driver> scheme，且必须有主机名；
#                                 并拒绝 query 里改写**客户端行为**的选项：
#                                 `local_infile` / `allow_local_infile` /
#                                 `read_default_file` / `read_default_group`，
#                                 以及带 CLIENT_LOCAL_FILES 位的 `client_flag`。
#                                 理由：主机白名单只回答"连到谁"，不回答"连过去之后
#                                 客户端愿意干什么"——`?local_infile=1` 会让**对端
#                                 服务器**要求本客户端上传本地文件（实测该键被
#                                 SQLAlchemy coerce 后进入 pymysql 的 connect args，
#                                 并把 client_flag 置上 LOCAL_FILES 位）。
#                                 显式写 `local_infile=0` / `client_flag=2048` 不受影响。
#   + KB_MYSQL_ALLOWED_HOSTS      逗号分隔白名单；条目 `host`、`host:port`、
#                                 `.example.com`（= 该域的子域，**不含 apex 本身**，
#                                 apex 要单独一条，防止加通配顺手把 apex 也放行）
#
# ⚠️ 闸门开启但白名单留空 = 只校验 scheme，这是过渡状态，不是"已经收紧"。
#    校验刻意不做 DNS 解析：解析要出网、把延迟绑在被校验对象上，且连接时会重新解析，
#    TOCTOU 并没有被堵住。真正拦"服务端被当代理使"的是白名单 + 网络侧 egress 策略。
# ---------------------------------------------------------------------------
KB_MYSQL_URL_GUARD=false
KB_MYSQL_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# WHERE 参数化闸门（2026-10-23 新增；config.py 读取键：KB_MYSQL_WHERE_PARAMETRIZED；
# 实现见 kb_service/core/sql_filters.py，缺口登记见 docs/项目实现手册.md §24.2 G12
# 「仍未收口」与 §24.3 T1 ⑫）
#
# 为什么需要：`MySQLIngestRequest.where` 是一段**原始 SQL 片段**，被
# `f" WHERE {request.where}"` 直接拼进 `SELECT * FROM \`t\` WHERE …`。现有的
# `_validate_where_fragment` 只拦 `;` 与 `--`/`/*`，它挡得住堆叠语句，挡不住
# `1=1 OR 1=1`、`id IN (SELECT user FROM mysql.user)` 这类**合法但越界**的片段，
# 因为对拼出来的 SQL 而言，调用方给的就是语法。今天这段输入"可信"是因为它只来自
# 操作员手敲；一旦有任何界面把它接到非操作员输入上，它立刻是注入点。
#
# 语义（默认关，关闭时与加固前逐位等价）：
#   KB_MYSQL_WHERE_PARAMETRIZED=false  `where` 照旧拼接；请求里带 `filters` → 400
#                                    （静默忽略一个调用方以为生效的过滤条件，
#                                     等于把全表灌进向量库，所以显式拒绝）
#   KB_MYSQL_WHERE_PARAMETRIZED=true   `where` 一律 400；过滤只能走 `filters`：
#                                    `[{"column":"year","op":"eq","value":2024}, …]`
#                                    列名必须是纯标识符（字母/数字/下划线，≤64 位，
#                                    与 `table` 同口径）；`op` 取封闭枚举
#                                    eq/ne/gt/ge/lt/le/like/in/not_in/is_null/is_not_null；
#                                    值全部走 bindparams，**永远不进 SQL 文本**；
#                                    谓词之间只接受 AND（不接受 OR/括号/子查询——
#                                    需要布尔或关系时分多次导入，而不是让本服务拼一段
#                                    它看不懂的 SQL）；单次最多 32 个条件。
#
# ⚠️ 这是**破坏性**的一档：打开当天，所有仍在传 `where` / `--where` 的导入任务都会 400。
#    先把它们逐个迁到 `filters`（CLI 用 `--filters '<JSON 数组>'`，与 HTTP 请求体同形），
#    再开这个闸门。错误 detail 只说规则名与被拒的原因，不回显 `where` 或 `filters` 的值。
# ---------------------------------------------------------------------------
KB_MYSQL_WHERE_PARAMETRIZED=false
