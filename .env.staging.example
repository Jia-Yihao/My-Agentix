# ============================================================================
# My Agentix 环境配置分层 —— 预发环境差异项（P1 部署收口）
#
# 用法：以 `.env.example` 为母本复制为 `.env`，再用本文件的差异项覆盖。
# 配套：docker/compose.override.staging.yml（预发 compose 叠加层）。
# 未列出的项沿用母本。
# ============================================================================

# ---------- 应用基础 ----------
APP_NAME=My Agentix
DEBUG=False                     # 预发：生产同等启动方式（多 worker、无 --reload）
REQUIRE_API_KEY=true            # 预发：必须启用认证
API_KEY=                        # 必填：预发网关/联调方使用的 API Key
SECRET_KEY=                     # 必填：随机 64+ 字符（python -c "import secrets;print(secrets.token_urlsafe(48))"）

# ---------- 限流（预发：开启并使用全局阈值） ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPM=300
RATE_LIMIT_GLOBAL_BURST=60

# ---------- 观测（预发：接 OTel collector / 监控栈） ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_CONSOLE_EXPORT=false

# ---------- 初始化类（预发：允许构建期 LightRAG 初始化，需 LLM_API_KEY） ----------
INIT_LIGHTRAG_ON_BUILD=true
LIGHTRAG_INIT_LIMIT=1000

# ---------- 中间件凭据（预发：Redis 建议设密码） ----------
REDIS_PASSWORD=                 # 必填：与 redis 服务 REDIS_PASSWORD 一致

# ---------- 编排资源（预发：接近生产配比） ----------
RETRIEVAL_WORKER_REPLICAS=1
RETRIEVAL_WORKER_CPUS=2.0
RETRIEVAL_WORKER_MEMORY=4g
