# ============================================================================
# My Agentix 环境配置分层 —— 生产环境差异项（P1 部署收口）
#
# 用法：以 `.env.example` 为母本复制为 `.env`，再用本文件的差异项覆盖。
# 安全红线：所有 API_KEY/SECRET_KEY/密码经密钥管理注入，禁止入库（见
# docs/runbooks/密钥管理.md）；本文件任何密钥字段留空占位。
# 未列出的项沿用母本。
# ============================================================================

# ---------- 应用基础 ----------
APP_NAME=My Agentix
DEBUG=False                     # 生产：强制 False（--reload 绝不允许出现）
REQUIRE_API_KEY=true            # 生产：强制启用认证
API_KEY=                        # 必填
SECRET_KEY=                     # 必填：随机 64+ 字符

# ---------- 限流（生产：开启，阈值按容量评估） ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPM=300
RATE_LIMIT_GLOBAL_BURST=60

# ---------- 观测（生产：必接 collector，监控栈随 compose 启动） ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_CONSOLE_EXPORT=false

# ---------- 初始化类（生产：一律 false——初始化只在预发演练、生产只做增量入库） ----------
INIT_LIGHTRAG_ON_BUILD=false
INIT_KB_EXCEL=false

# ---------- 中间件凭据（生产：全部必填） ----------
REDIS_PASSWORD=                 # 必填
NEO4J_PASSWORD=                 # 必填：勿用默认 legalpass
POSTGRES_PASSWORD=              # 必填：勿用默认 postgrespass（见 compose postgres 服务）

# ---------- 编排资源（生产：按容量规划） ----------
RETRIEVAL_WORKER_REPLICAS=2
RETRIEVAL_WORKER_CPUS=2.0
RETRIEVAL_WORKER_MEMORY=4g
