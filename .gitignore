.workbuddy-ai/
uploads/

# tiktoken BPE 词表缓存：首次调用 tiktoken 时自动下载重建，属运行时缓存
data/tiktoken_cache/

# KB 向量库灌库标记（0 字节运行期状态，由 init 脚本按需生成）
data/.kb_milvus_ingested

# 历史架构图：标题含旧项目名且已无任何引用，仅保留本地副本不入库
data/1.png

# AI 编程助手工作目录（华为 CodeArts Doer），性质同 .workbuddy-ai/
.codeartsdoer/

# AI 协作交付物（S5 验收单 / eval harness 验证产物），工作产物不入库
deliverables/

# 融合迁移：归档产物目录（旧 RAG 等归档，保留 git mv 历史但排除最终产物）
archive/

# 融合迁移中间产物（pytest 临时目录、迁移回填临时文件）
.pytest_tmp/
*.migration-tmp

# eval 运行期产物（每次跑分重写，带时间戳）：真正入库的是**输入**
# evals/baseline_predictions.jsonl 与**生成物** evals/baselines/quality.json
# （由 evals/write_quality_baseline.py 从这些 summary 生成）。
# CI 用 --results-dir 落到 $RUNNER_TEMP，本地落这里；两者都不该被 git add。
evals/results/
evals/ablations/results/

# bench 运行期产物（T1：测量原始数据 + 环境指纹，每次跑落新文件，不入库；
# 入口默认落点见 bench/run.py 的 --out-dir，README 同口径）
bench/results/

# 测试套件不随仓库发布（仅本地验证用）
/tests/

# 详细文档不随仓库发布，只在本地保留：设计说明、ADR、Runbook、实现细节、
# 评测框架说明一律走这条。仓库对外只留声明性文档（README / LICENSE /
# CONTRIBUTING / SECURITY / CODE_OF_CONDUCT 与各模块 README）。
# 两个例外仍随仓库分发：README 用的配图，以及首页指标表所依据的评测汇总。
/docs/*
!/docs/assets/
!/docs/evals/
/evals/README.md

# 运行时哨兵与跑批产物不入库
kb_ingest/data/.*_ingested
evals/reports/
