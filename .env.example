# 应用配置
# ================== 必要参数说明 ==================
# • LLM_API_KEY / LLM_BASE_URL / LLM_MODEL：主聊天模型的凭据与地址，必须按实际账号配置。
# • EMBEDDING_API_KEY / EMBEDDING_BASE_URL / EMBEDDING_MODEL：向量化服务的凭据，Milvus/知识库检索依赖于此。
# • VISION_API_KEY / IMAGE_GENERATION_API_KEY：若需图片理解或生成，需替换为有效密钥，否则保持为空。
# • 数据库连接信息（DATABASE_URL、MILVUS_HOST、NEO4J_URI 等）须与 docker-compose 或自建环境一致，否则相关功能无法启动。
# • LightRAG 依赖上面的 LLM/Embedding 配置，并使用 AUTO_BOOTSTRAP_LIGHTRAG/LIGHTRAG_WORKING_DIR 控制初始化行为。
# ==================================================
APP_NAME=My Agentix
APP_VERSION=0.2.0
DEBUG=True

# API配置
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# 安全配置
# REQUIRE_API_KEY: 是否强制校验 API Key（warn 模式仅告警不拦截）
REQUIRE_API_KEY=false
# API_KEY: API 鉴权密钥（客户端请求需携带；REQUIRE_API_KEY=true 时必填）
API_KEY=
# V1_REQUIRE_JWT: v1 用户面端点（chat/sessions/upload 写操作）是否要求有效 Bearer JWT；
#   机器面 events/ops 由 REQUIRE_API_KEY 管辖。默认 false = v1 匿名域行为不变
V1_REQUIRE_JWT=false
# SECRET_KEY: 应用密钥（会话签名等；生产环境必须显式配置，缺失将拒绝启动）
SECRET_KEY=

# Agent 运行配置（P0-1 / P0-2 / P0-3）
# CHECKPOINTER_TYPE: LangGraph 会话持久化后端——redis（需 RediSearch，失败自动降级 memory）或 memory
CHECKPOINTER_TYPE=redis
# CHECKPOINTER_FAIL_CLOSED: Redis 路径初始化失败时是否拒绝启动——true=fail-closed（抛 RuntimeError，绝不落 MemorySaver）；默认 false 维持降级；显式 CHECKPOINTER_TYPE=memory 不受影响
CHECKPOINTER_FAIL_CLOSED=false
# CHECKPOINTER_RETRY_INTERVAL_S: T22 Redis 降级 MemorySaver 后重试升级的间隔秒数——0（默认）= 关闭重试循环（不建后台任务）
CHECKPOINTER_RETRY_INTERVAL_S=0
# CHECKPOINTER_RETRY_MAX_ATTEMPTS: T22 升级重试的每进程尝试上限（防重试风暴）；仅间隔 > 0 时生效
CHECKPOINTER_RETRY_MAX_ATTEMPTS=3
# EVENT_PORT_BACKEND: EventPort 后端——memory（默认，进程内）/ jsonl（追加事件日志 events/event_log.jsonl）/ redis_stream（Redis Stream，需 Redis 运行时）
EVENT_PORT_BACKEND=memory
# Phase 23: notify_user outbound tool — records to EventPort (type=user_notification), queryable via ops; no real email/sms this batch (default off)
NOTIFY_USER_ENABLED=false
# LEGACY_ERROR_MODE: 错误语义回滚开关——true 恢复旧行为（吞异常返 200 + 兜底文案）；
# false（默认）为结构化错误（503/500 或 200 + status=degraded + error_code）
LEGACY_ERROR_MODE=false


# LLM 服务配置(用于文本生成和问答)
LLM_PROVIDER=openai
# 模型快照固定纪律（P1-4）：走云 API 时必须钉**快照版本号**（如 `qwen3-max-2026-xx-xx`
# 这类带日期的版本），禁用 `latest` / 浮动别名。理由：`evals/run_eval.py --compare`
# 的 A/B 对比与质量基线的可比性，都依赖"同一模型快照"
# 这一前提——供应商悄悄升级浮动别名后，指标波动会被误判为代码退化。
# LM Studio 等本地端点的模型名本身就是快照（本地文件即版本），无需额外处理。
LLM_MODEL=qwen3-max
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 凭据回退名（2026-10-06 完整性审查补齐：代码会读、但此前本文件未声明）
# 优先级见 agentix/retrieval/config.py —— DEEPSEEK_* 若设置会**覆盖**上面的 LLM_*，
# OPENAI_* 是最后的兜底（许多人 shell 里已 export OPENAI_API_KEY，会静默生效）：
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_PROVIDER=glm 时的专用 key（LLM_API_KEY 为空才回退到它，见
# kb_ingest/kb_service/clients/llm.py）：
# GLM_API_KEY=
# 启动脚本 scripts/start_chatbot.py 可覆盖 vite 端口：
# VITE_PORT=5173
# VITE_API_BASE_URL: 前端 dev 直连后端的绝对地址（仅本地开发用）。不配 = 走 Vite proxy
# （/api → localhost:8000，默认且推荐）。配成绝对地址会被打进构建产物，容器部署
# （nginx 同源反代）下绕过 nginx 必然连接失败——生产构建前务必留空。详见 README「VITE_API_BASE_URL」告警段。
# VITE_API_BASE_URL=

# ── LangSmith tracing 看板（P1-2，可选，默认关）──────────────────────────
# 经 langchain-core tracing 回调自动上报，零业务代码（langsmith 为 langchain 家族
# 传递依赖，无需新增安装）。免费档口径：1 席 / 5000 base traces / 月（超出丢弃）/
# 轨迹保留 14 天——别当归档系统，重要结论及时导出。
# 默认 false = 零上报零行为变化；上报失败 fail-open（丢遥测不丢请求）。
# 只接开发/评测流量；法律域真实数据是否上云由使用者自行决定。
# LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=my-agentix


# 视觉模型配置（用于图像分析）
VISION_API_KEY=your_vision_api_key_here
# 只填 base（到 /v4 为止），代码会自动拼 /chat/completions
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6

# 图像生成模型配置（用于生成图片）
IMAGE_GENERATION_API_KEY=your_image_generation_api_key_here
IMAGE_GENERATION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_GENERATION_MODEL=cogView-4-250304
IMAGE_GENERATION_SIZE=1024x1024

# Milvus向量数据库配置
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=legal
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=IP
# Phase H·W2: IVF search nprobe (default 16 = former hardcoded value, behavior-equal)
MILVUS_NPROBE=16

# Embedding 服务配置(用于向量生成)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# Embedding 结果本地缓存（agentix/retrieval/infra/embedding/cache.py，键=sha256(model+text)）。
# 与上面几个生效行不同，这里**全部为注释示例**：代码内已有默认值，写成生效行会让
# 「.env ↔ .env.example 缺项自检」把每个新部署都报成配置面变化（同 RETRIEVAL_* 的口径）。
# EMBEDDING_CACHE_ENABLED=true            # 缓存总开关（出厂即开；关掉后每次检索都打端点）
# EMBEDDING_CACHE_PATH=                   # 空 = DATA_DIR/embedding_cache.db
# EMBEDDING_CACHE_MAX_ENTRIES=200000      # FIFO 上限（超出裁到 80%）
#
# E4 · 启动预热（docs/design/性能与优化路线图.md §2 E4）。三个键默认**关/空**：
# 开着它等于每次启动都打一批端点调用，属行为变更，不作出厂形态。
# 分隔符只认 `;`／`；`／换行——半角逗号会把英文问句从中间劈开。
# 开关开着但清单为空 ⇒ 响亮跳过（日志 reason=empty_list），不会静默 0 条了事。
# EMBEDDING_CACHE_PREWARM_ENABLED=false
# EMBEDDING_CACHE_PREWARM_QUERIES=民法典第188条的诉讼时效是几年；合同编通则解释第几条规定彩礼
# EMBEDDING_CACHE_PREWARM_MAX=32          # 首刷上限（去重后截断；<=0 会被启动自检判为非法）
#
# E7 · 召回级语义结果缓存（docs/design/性能与优化路线图.md §2 E7）。三个键同样
# 只活在检索域配置面（agentix/retrieval/settings.py），**全部注释示例、默认关**：
# 命中的代价是"复用另一问法检索到的文档"，属行为变更，不作出厂形态。
# τ 是"多像才算同一个问题"，出厂 0.95 是保守值而非调优值——调它要有命中率/串答基准，
# 目前仓库里没有这组基准（README §11 的金标只测召回质量，不测语义缓存）。
# τ<=0 = 任何问法都算命中（会串答），τ>1 = 永远不命中（开了等于没开），两者都会被
# validate_app_settings() 判非法；TTL 比精确键的 RETRIEVAL_CACHE_TTL_SECONDS=600 短一个
# 量级，因为语义键复用的是"别人的那句话"。缓存是进程内的，多 worker 各持一份、互不共享。
# SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_TAU=0.95
# SEMANTIC_CACHE_TTL_SECONDS=120

# 可选：本项目检索域的 Cross-Encoder 精排服务（Docker Infinity profile）。
# 启动：docker compose --profile reranker up -d reranker
# 模型权重默认缓存在项目目录；Windows 可改为 E:/My-Agentix/reranker-cache。
# 注意：Infinity Docker 镜像本身仍存放在 Docker Desktop 配置的数据盘。
# RERANKER_CACHE_DIR=E:/My-Agentix/reranker-cache
# 如从 ModelScope 下载到缓存目录下的 model 子目录，将模型源设置为容器内路径：
# RERANKER_MODEL_SOURCE=/app/.cache/model
# 本机运行后端用 127.0.0.1；若 backend 也在 Compose 容器中，改为 http://reranker:7997。
# RERANKER_BASE_URL=http://127.0.0.1:7997
# RERANKER_MODEL=text-embedding-bge-reranker-v2-m3
# RERANKER_ENABLED=true
# 混合检索调试时再显式开启以下 flag；hybrid rerank 本身由 RETRIEVAL_HYBRID_RERANK 控制。
# RETRIEVAL_HYBRID_ENABLED=true
# RETRIEVAL_SPARSE_ENABLED=true

# Reranker 服务配置(用于精排)
RERANK_ENABLED=true
RERANK_PROVIDER=custom
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
RERANK_ENDPOINT=/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=6
RERANK_TIMEOUT=30
RERANK_SCORE_FUSION_ALPHA=0.5

# Redis配置（R3.2：单 Redis-Stack 实例 + DB 分片）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# R3.2 分片：db0 = cache + checkpoint（RediSearch 只能在 db0 建索引，db2 会让
# checkpointer 静默降级 MemorySaver）/ db1 = Celery
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1
REDIS_CHECKPOINT_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_REDIS_URL=redis://redis:6379/0
REDIS_CACHE_EXPIRE=43200
REDIS_CACHE_THRESHOLD=0.92
REDIS_CACHE_MAX_SIZE=1000

# 对象存储（R3.3：单 MinIO 实例，bucket 隔离）
# documents=业务文档；milvus bucket 由 Milvus 内部使用，无需业务侧配置
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_ENDPOINT_EXTERNAL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

# LightRAG配置
LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_RETRIEVAL_MODE=hybrid
LIGHTRAG_TOP_K=10
LIGHTRAG_MAX_TOKEN_SIZE=4096
LIGHTRAG_ENABLE_NEO4J=True
LIGHTRAG_ENABLE_MILVUS=False
# LightRAG 容器启动时自动复制内置模板数据（首次挂载卷为空时）
AUTO_BOOTSTRAP_LIGHTRAG=true

# LightRAG 构建时初始化配置（Docker）
INIT_LIGHTRAG_ON_BUILD=true
LIGHTRAG_INIT_LIMIT=10  #限制初始化的法条数量，注释则使用全部

# 数据库配置
# DATABASE_URL=sqlite:///./data/agentix.db  # 已废弃：现用下方 PostgreSQL（psycopg）连接
# 主机名 postgres 只在 compose 网络内解析：宿主直跑 uvicorn 会 getaddrinfo failed，
# 需显式覆盖成 127.0.0.1 + compose 映射端口（本机 postgres 映射见 docker-compose.yml）。
DATABASE_URL=postgresql+psycopg://postgres:postgrespass@postgres:5432/agentix

# Neo4j 配置
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalpass
NEO4J_DEFAULT_GRAPH_QUERY=MATCH (a)-[r]-(b) RETURN a, r, b LIMIT 100

# Agent配置
MAX_ITERATIONS=10
# LG-2-6：图执行落盘时机（LangGraph 1.2 durability）：sync=每步写完才走下一步；
# async=每步后台写、下一步不等（框架默认，与升级前行为一致）；exit=只在退出/中断/报错时写。
# 取值只接受 sync / async / exit，写错启动即报错（不静默回落）。默认值不是可靠性升级。
GRAPH_DURABILITY=async
AGENT_TIMEOUT=300
# 批次 B1：流式单事件间隔看门狗（与 AGENT_TIMEOUT 墙钟解耦），超时 → error+done
STREAM_IDLE_TIMEOUT=60
# Agent对话记忆保留的用户轮数（正整数；小于等于0表示保留全部历史）
LEGELBOT_MEMORY_TURNS=5

# 知识库配置
#  - KB_TOP_K:                       每次召回的候选数量
#  - KB_SIMILARITY_THRESHOLD:        召回阶段的最低相似度（Milvus 粗筛，最终由 rerank 决定）
#  - KB_POSTGRES_SIMILARITY_THRESHOLD: Postgres 结果 rerank 后保留的最低相似度
#  - KB_POSTGRES_RERANK_THRESHOLD:     Postgres 结果 rerank 后保留的最低得分
#  - KB_RERANK_SCORE_THRESHOLD:        [已弃用 R-P0-3] 无代码消费点；设置时告警并映射到 KB_POSTGRES_RERANK_THRESHOLD
#  - KB_CHUNK_SIZE/OVERLAP:           文本切分长度与重叠
#  - KB_SCOPE_DESCRIPTION:             KB 子图 guardrails 的领域范围说明（空 = 用内置测试数据集文案）
#  - KB_LLM_* / KB_EMBEDDING_*:       kb_ingest 服务使用的 LLM 与嵌入模型配置
#  - KB_RERANK_*:                     kb_ingest rerank 的参数
# KB_TOP_K: KB 最终返回的候选数量
KB_TOP_K=5
# KB_SIMILARITY_THRESHOLD: Milvus 粗召回阶段的最低相似度
KB_SIMILARITY_THRESHOLD=0.2
# KB_POSTGRES_SIMILARITY_THRESHOLD: PostgreSQL 结果的最小相似度
KB_POSTGRES_SIMILARITY_THRESHOLD=0.5
# KB_POSTGRES_RERANK_THRESHOLD: PostgreSQL 结果 rerank 得分阈值
KB_POSTGRES_RERANK_THRESHOLD=0.8
# KB_RERANK_SCORE_THRESHOLD: [已弃用 R-P0-3] 无代码消费点；设置时 WARNING 并把值映射到 KB_POSTGRES_RERANK_THRESHOLD（新键显式值优先）
KB_RERANK_SCORE_THRESHOLD=0.8
# KB_CHUNK_SIZE: 文本切分长度
KB_CHUNK_SIZE=512
# KB_CHUNK_OVERLAP: 文本切分重叠长度
KB_CHUNK_OVERLAP=80
# KB_SCOPE_DESCRIPTION: KB 子图 guardrails 的「本库处理什么」范围说明。
# 留空（默认）= 沿用代码内置的测试数据集文案，行为与加固前逐位等价；
# 语料换域（如法律条文库）时必须同步声明，否则 guardrails 会按旧域判 end 并拒答。
#KB_SCOPE_DESCRIPTION=
# KB_LLM_PROVIDER: kb_ingest 使用的生成模型供应商
KB_LLM_PROVIDER=openai
# KB_LLM_MODEL: kb_ingest 调用的生成模型名称
KB_LLM_MODEL=qwen3-max
# KB_LLM_API_KEY: kb_ingest 调用 LLM 的 API Key
KB_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KB_LLM_BASE_URL: kb_ingest 调用 LLM 的 Base URL
KB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KB_LLM_TEMPERATURE: kb_ingest 生成时的温度
KB_LLM_TEMPERATURE=0.3
# KB_USE_LLM: 是否启用 LLM 管线
KB_USE_LLM=true
# KB_EMBEDDING_PROVIDER: 嵌入模型供应商
KB_EMBEDDING_PROVIDER=openai
# KB_EMBEDDING_MODEL: 嵌入模型名称
KB_EMBEDDING_MODEL=text-embedding-v4
# KB_EMBEDDING_API_KEY: 嵌入服务 API Key
KB_EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KB_EMBEDDING_BASE_URL: 嵌入服务 Base URL
KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KB_EMBEDDING_DIMENSION: 嵌入向量维度
KB_EMBEDDING_DIMENSION=1024
# KB_RERANK_ENABLED: 是否启用 rerank
KB_RERANK_ENABLED=true
# KB_RERANK_PROVIDER: rerank 服务供应商
KB_RERANK_PROVIDER=custom
# KB_RERANK_BASE_URL: rerank 服务 Base URL
KB_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
# KB_RERANK_ENDPOINT: rerank 服务路径
KB_RERANK_ENDPOINT=/rerank/text-rerank/text-rerank
# KB_RERANK_API_KEY: rerank 服务 API Key
KB_RERANK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KB_RERANK_MODEL: rerank 模型名称
KB_RERANK_MODEL=qwen3-rerank

# ---------------------------------------------------------------------------
# kb_ingest 服务鉴权（2026-09 新增）
#
# 这两个变量被两处读取，因此天然一致，无需额外同步：
#   - kb_ingest 容器：`env_file: .env` ⇒ 读作自己的 `KB_REQUIRE_API_KEY` / `KB_API_KEY`；
#   - agentix：`settings.KB_API_KEY` ⇒ 出站调用时作 `X-API-Key` 头。
#     （agentix **不读** `KB_REQUIRE_API_KEY`：它只需知道"要不要带钥匙"，
#      而这件事由"`KB_API_KEY` 是否为空"决定；多读一个开关只会多一处可能不一致。）
#
# ⚠️ 刻意**不复用** agentix 的 `API_KEY`：对外凭证不能等于对内写权限，
# 否则任何拿到对外 Key 的客户端都能直接改写知识库（Milvus 集合）。
#
# KB_REQUIRE_API_KEY: kb_ingest 是否强制校验 X-API-Key。默认 false 时所有
#   端点开放，但容器启动会打 WARNING 说明暴露面（端口 8100 发布到宿主机）。
# KB_API_KEY: 共享密钥。开启校验后必填，留空会导致全部请求 401（fail-closed）。
# ---------------------------------------------------------------------------
KB_REQUIRE_API_KEY=false
KB_API_KEY=

# ---------------------------------------------------------------------------
# kb_ingest · MySQL 连接串闸门（2026-10-23 新增，§24.2 G12 / §24.3 T1 ⑫）
#
# 本容器 `env_file: .env`，所以这两个键同样从这份文件读；完整语义与白名单写法
# 见 `kb_ingest/.env.example`（配置事实来源唯一，此处只给开关与默认值）。
#
# 为什么值得开：`/api/ingest/mysql` 的入参是**一整条带凭据的连接串**，服务端直接
# `create_engine()` 去连。`KB_REQUIRE_API_KEY` 只解决"谁能调"，不解决
# "调用的时候能让这台机器连哪儿"——`sqlite:////app/x.db` 可读任意本地文件，
# `mysql://attacker:3306` 可让服务端主动外连。
#
# KB_MYSQL_URL_GUARD=false（默认）⇒ 与加固前逐位等价。
# 开启后除 scheme/主机外还拒绝 query 里改写客户端行为的选项（`local_infile`、
# `read_default_file`、带 LOCAL_FILES 位的 `client_flag`）——主机白名单管"连到谁"，
# 这些选项管"连过去之后客户端愿意被读走什么"。
# KB_MYSQL_ALLOWED_HOSTS 留空 + 闸门开 = 只校验 scheme，是过渡态而非"已收紧"。
# ---------------------------------------------------------------------------
KB_MYSQL_URL_GUARD=false
KB_MYSQL_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# kb_ingest · WHERE 参数化闸门（2026-10-23 新增，§24.2 G12「仍未收口」的那半 / §24.3 T1 ⑫）
#
# 同一个服务、同一个理由的另一半：`/api/ingest/mysql` 的 `where` 是一段**原始 SQL 片段**，
# 被直接拼进 `SELECT * FROM \`t\` WHERE …`。现有的拦法只去掉了分号与注释，
# 挡得住堆叠语句，挡不住 `1=1 OR …` 这类合法但越界的片段——因为对拼出来的 SQL
# 来说，调用方给的就是语法。
#
# KB_MYSQL_WHERE_PARAMETRIZED=false（默认）⇒ 与加固前逐位等价（`where` 照旧拼接，
# 新字段 `filters` 被拒——静默忽略一个调用方以为生效的过滤条件，比报错更坏）。
# 开启后两条同时成立：`where` 一律 400，过滤只能走 `filters`
# （列名过标识符白名单、运算符取封闭枚举、值全部 bindparams，谓词之间只接受 AND）。
# ⚠️ 这是**破坏性**的一档：现存用 `--where` / `where` 的导入任务在打开当天会全部 400，
# 先逐个迁到 `filters` 再开。完整语义见 `kb_ingest/.env.example` 与
# `kb_ingest/kb_service/core/sql_filters.py`。
# ---------------------------------------------------------------------------
KB_MYSQL_WHERE_PARAMETRIZED=false

# 外部数据接入服务
# 设置后，create_query/file_query 会调用该服务的/api/ingest/excel
# 2026-10-06 修复：原先写死 http://localhost:8000，会被 docker compose 用于变量替换，
# 导致 backend 容器拿到 localhost:8000（容器自身）且与 kb_ingest 实际的 8100 端口不符。
# 默认注释：容器内走 docker-compose.yml 缺省 http://kb_ingest:8000；
# 本机直跑 backend 时再取消注释并改成 8100。
# INGEST_SERVICE_URL=http://kb_ingest:8000
# INGEST_SERVICE_URL=http://localhost:8100
# Excel导入默认启用增量更新
INGEST_INCREMENTAL_DEFAULT=true

# 本地文件接入的最大体积（MB）
FILE_UPLOAD_MAX_MB=2

# 是否允许联网检索（SerpAPI）
ENABLE_EXTERNAL_SEARCH=false
KB_ENABLE_EXTERNAL_SEARCH=false

# 对话历史配置
CONVERSATION_HISTORY_TTL=259200
CONVERSATION_HISTORY_MAX_MESSAGES=200

# CORS配置（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Ollama配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# 运行时护栏 / 特性开关
#
# 下列开关**默认关闭**（或保持既有行为）。开启前请阅读
# docs/architecture/运行时护栏.md 与 docs/architecture/配置管理.md。
# ---------------------------------------------------------------------------

# 可观测性：落 prompt / response / 工具入参摘要以支持按 trace_id 完整回放。
# 涉及落盘用户输入与模型输出（隐私 + 存储成本），由部署方显式开启；
# 开启后内容仍经脱敏（疑似密钥遮蔽）+ 截断（500 字符）。
OBSERVABILITY_PAYLOAD_CAPTURE=false

# Phase H·W0 性能真值（PhaseH_高性能运行时优化规划 §4）：
# SSE 终帧注入 breakdown_ms（ttft/retrieval/stream）——前端耗时芯片与回放消费。
# 默认关 ⇒ 帧与基线逐位等价。
LATENCY_BREAKDOWN_ENABLED=false
# 延迟总预算（毫秒）。0 = 不限额；超限仅 warning + degraded 计数（fail-open）。
LATENCY_TOTAL_BUDGET_MS=0
# 事件循环滞后采样任务（0.5s 间隔 → event_loop_lag_seconds 直方图）。默认关 = 零开销。
EVENT_LOOP_LAG_METRIC_ENABLED=false

# 上下文隔离：大中间产物外置阈值（字符）。超过则外置到 artifact store，
# 主状态只留句柄。设为 0 表示永不外置（回旧行为）。
ARTIFACT_INLINE_THRESHOLD=2000

# Token 预算：请求级硬上限。0 = 不限额（仅计量）。
TOKEN_BUDGET_PER_REQUEST=0
TOKEN_BUDGET_PER_AGENT=0
# 单请求工具调用硬上限。0 = 不限额。
TOOL_CALLS_PER_REQUEST=0

# 感知工具下游结果限量（数据库侧 LIMIT 管不到单行体量与写语句）。
TOOL_RESULT_MAX_ROWS=100
TOOL_RESULT_MAX_CHARS=8000

# 高风险动作人工审批（fail-closed：无人可批即不放行）。
HUMAN_REVIEW_ENABLED=false

# 终态完成度校验：开启后「环境事实判定为未完成」会把响应标为 degraded。
COMPLETION_VALIDATOR_STRICT=false

# 记忆整理：同主题摘要合并的时间相邻阈值（天）。0 表示只按主题分组。
MEMORY_CONSOLIDATION_MAX_GAP_DAYS=7.0

# Phase 24: 记忆整理触发 handler（task_queue 的 memory_consolidation；默认关）
MEMORY_CONSOLIDATION_ENABLED=false

# Phase 24: Agentic RAG——知识分支空检索时查询改写重试 ≤2 次（默认关）
AGENTIC_RAG_ENABLED=false

# Phase H·W1: complexity-aware routing fast-path - deterministic short-circuit for 5 closed reasons
# (chit_chat / statute_direct / capability_meta / identity_meta / ack_meta) skips the LLM intent classifier;
# capability_meta / identity_meta / ack_meta (assistant capability, identity, acknowledgement) only route to general-query (default off)
ROUTING_FASTPATH_ENABLED=false
# T8: 路由结果跨请求缓存（进程内、有界 LRU + TTL）——同问句重复提问时跳过 LLM 意图分类；
# 进程各自一份、不跨副本共享；换代（提示词/路由类/主模型/消融开关）与 TTL 到期即失效（默认关）
ROUTING_CACHE_ENABLED=false
# T30（审批与中断恢复优化规划 §4.3）：三层路由收敛为一层的业务总闸（默认关）。
# 开 = L1 一次调用同时产意图与执行参数，KB 检索路由并入 L1；关 = 现三层路由（L1 只产意图，
# A3 检索路由留在 KB 子图内），路由链与基线逐位等价。本开关只落配置面，收敛实现属 T30-2。
ROUTING_SINGLE_LAYER_ENABLED=false
# Phase 28: 需求澄清决策——歧义输入先澄清再执行（确定性启发，零新增 LLM；默认关）
CLARIFY_ROUTING_ENABLED=false

# Phase 28: 预算意识——状态栏常量键 max_iter + 剩余 ≤2 步轨迹 budget_notice（默认关）
BUDGET_NOTICE_ENABLED=false

# Phase 30: 进化提案三状态 append-only 档案（staged/applied/rejected 全记，content_hash 去重）
EVOLUTION_PROPOSAL_LOG=data/evolution/proposals.jsonl

# Phase 30: 离线睡眠学习触发 handler（门槛达标只产 staged 提案，不晋升）（默认关）
EVOLUTION_SLEEP_ENABLED=false

# R3.8: retrieval worker 独立伸缩
RETRIEVAL_WORKER_REPLICAS=1
RETRIEVAL_WORKER_CPUS=2.0
RETRIEVAL_WORKER_MEMORY=4g

# 企业化 P0-3: 全局限流中间件（按客户端 IP 令牌桶，覆盖全部路由）
# 主开关与检索域聊天路由限流（retrieval 侧 RATE_LIMIT_RATE/BURST）共用；
# 生产环境必须开启 RATE_LIMIT_ENABLED=true（启动自检强校验）。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GLOBAL_RPM=120
RATE_LIMIT_GLOBAL_BURST=240
# R1-4（技术变更指南 §2.1.5②）: 上传接口单独配额（重 IO+触发索引，配额更紧）
UPLOAD_RATE_LIMIT_RPM=20
UPLOAD_RATE_LIMIT_BURST=30

# 熔断器参数（检索域）。以下为**注释示例**：不设 = 用代码内默认值，
# 因此有意不写成生效行（否则自检会把它当成".env 缺失字段"而告警）。
# 语义：同一依赖的熔断状态全局唯一，**首建者胜**——若两个调用点传了不同参数，
# 生效的是先创建的那个，并会打一条 warning 说明（见 circuit_breaker.get_or_create）。
# LLM 调用熔断（retrieval/usecases/chat_llm.py）
# LLM_CIRCUIT_BREAKER_ENABLED=true
# LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
# 重排服务熔断（retrieval/infra/rag/rerank.py）；恢复时间默认比 LLM 长：重排模型冷启动更慢
# RERANK_BREAKER_FAILURE_THRESHOLD=5
# RERANK_BREAKER_RECOVERY_SECONDS=60

# RAG 混合检索 P1（F1a，检索增强深度优化.md §5 R-P1-1..5）：以下全部为**注释示例**
# （代码内默认值，不设即生效；有意不写成生效行，避免自检"缺项"告警噪声）。
# 总闸默认关 ⇒ flag-off 与现基线字节等价。
# 2026-10-11 本机法条评测：zscore α=0.75 + 10 个精排候选在 23 条金标上 MRR=0.7283，
# Recall@5=0.7826（18/23，与 Dense 持平）；仅供实验，不据此修改默认值。
# 参数组合及复现边界见 README §15.1。
# RETRIEVAL_HYBRID_ENABLED=false          # 总闸：rewrite→dense/sparse→rrf→rerank 四阶段链
# RETRIEVAL_SPARSE_ENABLED=false          # 子闸：进程内 BM25 sparse 通道（语料=PostgreSQL chunk 表）
# RETRIEVAL_SPARSE_MIN_SCORE=0.0          # sparse 通道弱命中裁剪（0=只保留 score>0）
# RETRIEVAL_SPARSE_CACHE_TTL=600          # BM25 索引进程内缓存 TTL（秒）
# RETRIEVAL_FUSION_METHOD=rrf             # 融合算法：rrf（默认，免调参）| zscore
# RETRIEVAL_RRF_K=60                      # RRF 平滑常数 k（多轮短问答可调小提升头部区分度）
# RETRIEVAL_FUSION_ALPHA=0.5              # zscore 下首通道（dense）权重（其余通道平分）
# RETRIEVAL_FUSION_TOP_N=200              # 融合候选池上限（进精排前截断）
# RETRIEVAL_HYBRID_RERANK=true            # hybrid 链内精排默认开（只在总闸开时生效）
# RETRIEVAL_RERANK_CANDIDATES=20          # 精排候选数（截断 TopK 前的候选上限）
# T9（approval-recovery-optimization §T9）：rerank 候选分批。默认 0=关 ⇒ 单次全候选调用（与基线逐位等价）；
# >0 = 每批候选数，分批打上游后按全局 relevance_score 降序融合（同分按原始下标升序）。
# RETRIEVAL_RERANK_BATCH_SIZE=0           # rerank 候选分批（0=关）
# R-P2-1（F2b-b）查询改写/HyDE：双可选独立 flag、默认关 = 基线逐位等价；失败回退原 query
# RETRIEVAL_QUERY_REWRITE_ENABLED=false   # 多轮改写（意图补全，LLM；预检路径带历史）
# RETRIEVAL_HYDE_ENABLED=false            # HyDE：先生成假设性文档再检索（LLM）
# Phase H·W2（PhaseH_高性能运行时优化规划 §4）：检索优化三闸 + 精排动态跳过，默认关
# RETRIEVAL_SINGLEFLIGHT_ENABLED=false    # 在飞合并：同参并发 miss 只跑一次检索（进程内）
# RETRIEVAL_ADAPTIVE_ENABLED=false        # 自适应级联：确定性分类 + 分数闸分级升级
# RETRIEVAL_CASCADE_MIN_SCORE=0           # 级联分数闸（0=关：空命中才升级；>0 归一化分数低于该值升级）
# RERANK_DYNAMIC_SKIP_ENABLED=false       # 精排动态跳过：候选≤4 或相似度口径首位分≥0.95 保序直过
# R-P3（README §15.2 口径③）：进程内检索器缓存，默认关 = 每次照旧重建（逐位等价）
# RETRIEVAL_RETRIEVER_CACHE_ENABLED=false # 复用进程内 (retriever, vectorstore)，省掉每检索的客户端重建 + FAISS 反序列化
# RETRIEVAL_RETRIEVER_CACHE_MAX_ENTRIES=8 # 缓存条目上限（LRU；键含 index.faiss mtime+size ⇒ 索引换代自动失效）
# KB_LOCAL_FUSION_ENABLED=false           # Channel B：kb local_search 两路 rank 融合（替代 postgres-else-milvus 丢分）
# KB_LOCAL_FUSION_METHOD=rrf              # Channel B 融合算法：rrf | zscore

# 企业化 P0-2: 监控栈端口（prometheus/grafana/alertmanager）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_PASSWORD=admin

# 企业化 P0-4: 链路追踪（OTel 已转硬依赖；不设端点则仅本地构建 span，无导出）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false

# 企业化 P1-5.3: LLM 全局并发上限（0=不限额；>0 时在途调用超限排队，排队超时快速失败）
LLM_MAX_CONCURRENCY=0
LLM_CONCURRENCY_QUEUE_TIMEOUT=5.0

# 企业化 P1-4.2: prompt injection 防线（检测默认开；入库阻断默认关——法律库误报代价高）
PROMPT_INJECTION_DETECTION_ENABLED=true
PROMPT_INJECTION_INGEST_BLOCK=false

# 企业化 P2-4.5: 长文本输入统一上限（各路由文本输入 DTO 共用，防 token 放大攻击）
QUERY_MAX_LENGTH=5000

# R2-2 法条效力过滤（指南 v2.0 §2.2.7①）:
# 检索后过滤已失效/未生效条文（默认开；存量无效力字段数据视为现行有效，无需重建索引）
EFFECTIVENESS_FILTER_ENABLED=true
# 答案尾部"检索截至日期"标注（默认开）
EFFECTIVENESS_ASOF_ANNOTATION=true

# R3-5 Context Engine（架构文档 §24-28 + 指南 v2.0 L1⑦）:
# authority 排序（source_authority_level 五档：法律>司法解释>案例>二级资料>网页；缺失档位 0 稳定排序）
CONTEXT_AUTHORITY_RANKING_ENABLED=true
# Context Budget（token 级贪心装配，超预算低档丢弃/截断）；0 = 不限额（默认，行为不变）
CONTEXT_BUDGET_TOKENS=0
# 大文档隔离（复用 artifact_store，超阈值片段全文外置、Prompt 留预览+句柄）；0 = 关闭（默认，启用需配合取回通道）
CONTEXT_ISOLATE_THRESHOLD=0

# R3-6 GroundingValidator（架构文档 §104）:
# 句子级证据锚定校验——观测模式：只产出报告与低分 WARN，不改答案、不拦截
GROUNDING_VALIDATOR_ENABLED=true
# 句子锚定阈值：bigram 包含度 >= 视为有证据支撑
GROUNDING_SUPPORT_THRESHOLD=0.35
# 低于该分数记 WARN（0 = 关闭 WARN）
GROUNDING_LOW_SCORE_WARN=0.6
# R-P2-2 证据门禁：observe（默认，与基线逐位等价）| warn（附警告）| refuse（降级拒答）
EVIDENCE_GATE_MODE=observe

# R3-7 Model Gateway（架构文档 §42-44）:
# 任务分档模型（§43）：空 = 回退 CHAT_MODEL/OPENAI_MODEL（单模型部署零行为变化）
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_MODEL_REASONING=
# Phase H·W1: role -> tier wiring through ModelGateway (empty map = baseline-equal; tiers: fast/standard/reasoning)
LLM_TIER_ROUTING_ENABLED=false
LLM_ROLE_TIER_MAP=
# 满意度反馈闭环（P2-1）：默认关——flag-on 才注册 POST /api/v1/feedback
# （落 EventPort type=message_feedback），flag-off 路由不存在=与基线等价。
# FEEDBACK_PII_REDACT 默认开（脱敏是安全项，开为安全默认）。
FEEDBACK_ENABLED=false
FEEDBACK_PII_REDACT=true
# Fallback 链（§44）：逗号分隔（如 deepseek-v4-flash,qwen3.5-9b）；空 = 无 fallback（主链路零行为变化）
LLM_FALLBACK_MODELS=
# 跨端点 fallback 规格（P1-1）：逗号分隔的 `model|base_url|api_key_env` 三元组，
# 用 `|` 分隔（base_url 含 `://` 不能用 `:`）。示例（LM Studio 本地模型做降级备份）：
#   LLM_FALLBACK_MODEL_SPECS=qwen/qwen3.5-9b|http://localhost:1234/v1|LLM_FALLBACK_API_KEY
# api_key_env 是**环境变量名**（密钥不落配置值，且不与主 LLM_API_KEY 复用——密钥隔离纪律），
# 需在 .env 中另行设置该变量；base_url/api_key_env 段可空（`model||` = 仅模型名，回退主端点）。
# 非空时**覆盖** LLM_FALLBACK_MODELS；两键皆空 = 无 fallback（与基线逐位等价）。
LLM_FALLBACK_MODEL_SPECS=
# 总尝试上限（含 primary），硬上限防「模型故障→无限重试→成本爆炸」
LLM_FALLBACK_MAX_ATTEMPTS=2

# R3-8 Semantic Memory 卡片（架构文档 §32）:
# 从会话摘要提取稳定偏好卡（Extractor→Dedup→Conflict→Store）；
# 仅在 MEMORY_CONTEXT_ENABLED=true 时生效（后者默认关）
MEMORY_CARDS_ENABLED=true

# Phase 29（Ch3 §3.5/§3.6）：UserProfile 结构化 profile_card
# （JSON Cards + derive_profile 派生幂等；与上面语义卡片是不同特性）。
# 可选项：不设 = 默认 false（to_dict() 序列化与基线字节等价）。
MEMORY_PROFILE_CARD_ENABLED=false

# P6-6.1（source-code-study §5 表 6.1）：MemoryPort↔Redis 扇出召回，
# 挂在 MEMORY_CONTEXT_ENABLED 通道之下（默认关 = 读路径与基线逐位等价）
MEMORY_FANOUT_ENABLED=false
# P6-6.2（§5 表 6.2）：摘要后台评审——异步晋升稳定卡片为画像条目（默认关）
MEMORY_REVIEW_ENABLED=false
# A2c: expose remember/recall/forget long-term-memory tools (declarations + ToolExecutor handlers; default off = baseline-equal)
MEMORY_TOOLS_ENABLED=false
# F1b: in-process memory recall upgrades to keyword x vector dual-path with recency decay (embedding reuses the retrieval vector stack; fail-open to keyword; default off = baseline-equal)
MEMORY_VECTOR_RECALL_ENABLED=false
# F1b2: MEMORY 索引制——记忆注入段改为「索引 + obs:// 指针」，正文外置 ArtifactStore，取回走 read_artifact；挂 MEMORY_CONTEXT_ENABLED 通道（默认关 = 注入与基线逐位等价）
MEMORY_INDEX_ENABLED=false
# F2a: 画像字段分级（stable vs session，profile_scope 单源）+ 跨会话沿用授权边界——未授权 fail-closed 只注会话层（默认关 = 注入与基线逐位等价）
MEMORY_PROFILE_SCOPE_ENABLED=false

# ---------------------------------------------------------------------------
# Settings 字段补全（2026-09：对齐 agentix.config.Settings.model_fields）
#
# 下列均为**可选项**：不设 = 用代码内默认值。已列入 selfcheck 的
# DEFAULT_IGNORED_MISSING，本地 .env 省略不会告警。
# ---------------------------------------------------------------------------
# JWT algorithm
ALGORITHM=HS256
# JWT access token expiry in seconds (default 24h)
ACCESS_TOKEN_EXPIRE_SECONDS=86400
# Enable Cookie Session fallback auth (rollback switch for R2.3)
AUTH_COOKIE_SESSION_FALLBACK=false
# Estimated cost per 1K input (prompt) tokens, in currency units
LLM_INPUT_PRICE_PER_1K=0.0
# Estimated cost per 1K output (completion) tokens, in currency units
LLM_OUTPUT_PRICE_PER_1K=0.0
# Trajectory sink backend: 'memory' (default) or 'jsonl' (persisted)
TRAJECTORY_SINK=memory
# File path for the JSONL trajectory sink (required when TRAJECTORY_SINK=jsonl)
TRAJECTORY_PATH=
# 日志输出格式（M2-1 起真源在 agentix/config/settings.py，此前定义在检索域兼容层）。
# 取值语义沿用旧的 _bool_env 口径：字符串小写后只认 1/true/yes 为真，
# 其余一律为假（注意 `on`/`y`/`t` 判 **False**，与 pydantic 原生 bool 解析不同）。
LOG_JSON_ENABLED=true
# 根 logger 级别；读取时无条件转大写（`debug` ⇒ `DEBUG`，旧行为逐位保留）。
LOG_LEVEL=INFO
# 轨迹落盘根目录（其下按 UTC 日期建子目录）。**刻意注释掉**：默认值是按本仓库根
# 推导出的 `<仓库根>/eval/results/traces`，写一行空值（`TRAJECTORY_DIR=`）会被
# pydantic 当成"显式设成空串"，落到 `Path("")` ⇒ 轨迹改写到当前工作目录下，
# 与代码默认不等价。需要自定义时取消注释并填绝对路径。
# TRAJECTORY_DIR=/absolute/path/to/traces
# Half-life in days for recency decay in long-term memory recall; <=0 disables decay
MEMORY_RECENCY_HALF_LIFE_DAYS=14.0
# Max chat messages kept in the checkpointer-backed graph state per session; <=0 disables windowing
MAX_HISTORY_MESSAGES=20
# Inject long-term memory context into general-query prompts
MEMORY_CONTEXT_ENABLED=false
# Max memory summaries recalled per query
MEMORY_RECALL_LIMIT=3
# Validate final KG answer via LLM structured check between summarize and final_answer nodes
KG_FINAL_ANSWER_VALIDATION=false
# Phase H·W1: verification budget - any dimension exceeded => fail-open degrade (same semantics as validation failure)
VERIFICATION_MAX_LLM_CALLS=1
VERIFICATION_TIMEOUT_MS=1000
VERIFICATION_TOKEN_BUDGET=0
# A3: shadow-compare the KG in-graph planner against the unified planner (report-only)
KG_PLANNER_SHADOW_ENABLED=false
# A3: cut KG graph planning over to the unified planner (skip private in-graph LLM chain)
KG_PLANNER_UNIFIED_ENABLED=false
# Stage F2b-d (R-P2-3): use discovered+curated schema render in text2cypher generation prompts (off = raw graph.schema baseline)
KG_SCHEMA_AWARE_GENERATION_ENABLED=false
# Stage F2b-d (R-P2-3): attach successful tool results to observation meta['evidence'] for verifier L2/L3 (off = no evidence key)
EVIDENCE_POOL_ENABLED=false
# Stage F2b-d (R-P2-3): enable LayeredVerifier L3 grounding at production call sites (off = require_grounding=False baseline)
VERIFIER_GROUNDING_ENABLED=false
# Text2SQL execution backend: mysql (default) | wren
TEXT2SQL_BACKEND=mysql
# Text2SQL 的目标库连接串：留空 = 用应用自身的 DATABASE_URL（接线前行为）。
# 法律库（data/init_mysql.sql 建的 legal_db）与应用元数据库不是同一个库时，
# 这里显式指向法律库，否则 text2sql 只能看见会话/产物这类元数据表。
# 例：mysql+pymysql://legal_user:legalpass@127.0.0.1:13306/legal_db
TEXT2SQL_DATABASE_URL=
# Wren project directory containing wren_project.yml and target/mdl.json
WREN_PROJECT_PATH=
# WrenEngine data_source for direct-engine path (wren_langchain absent)
WREN_DATA_SOURCE=duckdb
# WrenEngine connection_info JSON for direct-engine path
WREN_CONNECTION_INFO={}
# Default max rows returned by Wren-backed Text2SQL execution
WREN_QUERY_LIMIT=1000
# R-P2-4（F2b-c）Text2SQL 加固：dry-run = 校验节点 EXPLAIN 试跑（失败喂重试环，基础设施故障 fail-open）
TEXT2SQL_DRY_RUN_ENABLED=false
# R-P2-4（F2b-c）：schema 按 (DATABASE_URL, 问题) 缓存 TTL 秒（0 = 关闭 = 每问现拉）
TEXT2SQL_SCHEMA_CACHE_TTL_SECONDS=0
# Max artifacts kept in the in-memory artifact store
ARTIFACT_STORE_MAX_ITEMS=200
# Max total bytes kept in the in-memory artifact store
ARTIFACT_STORE_MAX_BYTES=8388608
# F1b2: ContextEngine 超长观测隔离时把正文外置 ArtifactStore，isolated_refs 落 obs://{artifact_id}（read_artifact 可取回；默认关 = 隔离引用与基线逐位一致，外置失败 fail-open 回裸引用）
CONTEXT_ISOLATE_PERSIST_ENABLED=false
# Max consolidation groups produced per run
MEMORY_CONSOLIDATION_MAX_GROUPS=10
# Max agent runs tracked by the in-process control plane
CONTROL_PLANE_MAX_RUNS=500

# Phase 25: 控制平面准入（0 = 不限；超限 spawn 抛 AdmissionDenied fail-closed）
CONTROL_PLANE_MAX_CONCURRENCY=0
CONTROL_PLANE_MAX_DEPTH=0
# T21 (approval-recovery plan): persist control-plane run states (create + every transition) so
# POST/GET /agents/runs survive restarts. Off (default) = in-process memory only AND byte-for-byte
# baseline-equal: the persistence layer is never imported, no table is created, nothing is read or
# written, and the response shape is unchanged (meta has no thread_id key).
# On = spawn/mark_running/finish/cancel are written to `agent_run_states` through a bounded background
# queue + single writer thread (sync SQLAlchemy never runs on the event loop); GET single/lists fall
# back to the DB on an in-memory miss (in-memory entries win on merge), and `meta.thread_id` is
# added when options.session_id is present (response-shape change, registered in the implementation
# manual's Run API section). Write failures are FAIL-OPEN: a warning plus stats().persist_errors /
# persist_dropped counters only - the run keeps going and the in-memory state is never rolled back.
# Assembly has exactly one source: agentix/runtime/control_plane.py::resolve_run_state_store.
# Rollback: set false + DROP TABLE agent_run_states.
RUN_STATE_PERSIST_ENABLED=false

# Phase H·W3: 运行时治理（默认关/0 = 与接线前逐位等价）
# 准入三态（放行/排队/拒绝 429）挂 Control Plane 入口
ADMISSION_CONTROL_ENABLED=false
# 全局并发上限（0 = 回落 CONTROL_PLANE_MAX_CONCURRENCY，两者皆 0 = 不限）
ADMISSION_MAX_CONCURRENT_RUNS=0
# 排队深度（0 = 超限即拒；>0 时入队等位，等待超时 30s 仍拒绝）
ADMISSION_MAX_QUEUE=0
# 只读节点的原生节点级重试（langgraph 1.x add_node(retry_policy=)）：false = 注册处完全不传，与基线逐位等价
# 覆盖面仅 6 个只读节点（analyze_and_route_query / respond_to_general_query / create_research_plan /
# create_kb_query / create_image_query / create_file_query）；execute_task 与 code_agent 永不挂（重跑会重放工具副作用）
# 预发/生产建议 true：只读节点重放无副作用，429/超时类瞬时故障由框架重试一次而非整轮失败
NODE_RETRY_ENABLED=false
# 主图节点的原生超时（langgraph 1.x add_node(timeout=)），单位秒，作用在每次节点尝试上
# 0（代码默认）= 注册处完全不传 timeout 形参，与基线逐位等价
# 开启注意：① 超时靠 asyncio 协作式取消，只在节点让出事件循环时生效，同步阻塞杀不掉；
# ② NodeTimeoutError 已从业务 is_retryable 排除，不会与 NODE_RETRY_ENABLED 叠成「超时→重试→再超时」；
# ③ execute_task / code_agent 被超时取消时工具可能已产生副作用——生产启用前请评估其与
#    恢复期幂等（LG-3-4）/ 节点错误补偿（LG-3-5）的先后关系
NODE_TIMEOUT_SECONDS=0
# 有副作用节点（execute_task / code_agent）的原生错误补偿（langgraph 1.x add_node(error_handler=)）
# false（代码默认）= 注册处完全不传 error_handler，与基线逐位等价
# true = 节点失败（无 retry_policy 时即首次失败）不再整轮 500：补偿记录落 hitl_pending_approvals
# （status=rejected / decided_by=system:node_error_handler），并把如实失败回执写进 messages 后路由到 END；
# handler 不重跑节点（副作用铁律），写库失败只告警（fail-open）
# 前置：补偿记录的存储装配只认 hitl_bridge.resolve_pending_store ⇒ 还需 HITL_PENDING_PERSIST_ENABLED=true
# 才真的写记录；该键关（默认 false）或装配失败时只给「补偿记录未写（补偿存储未装配）」回执 + logger.warning，
# 不兜底自建表（本键只保证失败不再整轮 500，不保证有记录）
NODE_ERROR_HANDLER_ENABLED=false
# 优雅关闭（langgraph 1.2 原生 RunControl；调用级，每次运行新建）
# false（代码默认）= 不装 SIGTERM/SIGINT 处理器、astream_events 不传 control，与基线逐位等价
# true = 收到 SIGTERM/SIGINT 先 request_drain()：在跑的图在**超步边界**停下并落 checkpoint
# （GraphDrained，线程可被 alist() 列出 ⇒ 启动恢复/续跑可接手），再把信号转交 uvicorn 退出
# 注意：drain 依赖节点让出事件循环；同步阻塞节点会拖到超时，由 RUN_DRAIN_TIMEOUT_S 兜底强制退出
RUN_CONTROL_ENABLED=false
# drain 上限（秒）：到点仍在跑 ⇒ 进程强制退出（不无限等）；只在 RUN_CONTROL_ENABLED=true 时生效
RUN_DRAIN_TIMEOUT_S=30
# run 级共享重试预算桶（task/tool/retrieval 三层共用，防 3×3×3 放大）
# 代码默认仍是 false（Settings 字段默认值，纪律 1）；这里写 true 是**部署推荐值**：
# 桶只收紧重试放大、不新增任何调用，耗尽即停；额度由 RETRY_BUDGET_TOKENS 定（首 attempt 不占额度）。
RETRY_BUDGET_ENABLED=true
RETRY_BUDGET_TOKENS=6
# 三层（tool/task/retrieval）自研退避与 langgraph RetryPolicy 默认对齐（0.5/2.0/128.0/3/jitter）
# false = 各层保留历史数值（工具 0.2 起步无抖动、task 上界 8s、检索用 KB_RETRIEVAL_* 配置）
RETRY_BACKOFF_ALIGNED=false
# 工具超时 = min(spec, 剩余 run 预算)（deadline 经 RequestScope 传播）
ADAPTIVE_TOOL_TIMEOUT_ENABLED=false
# 七级降级阶梯（lag/队列深度/下游熔断输入，后台优先甩，L6 礼貌拒绝 429）
LOAD_SHEDDING_ENABLED=false
# 出口隔离舱池尺寸（0 = 不限；LLM 池复用 LLM_MAX_CONCURRENCY 不另设）
BULKHEAD_RETRIEVAL_SIZE=0
BULKHEAD_NEO4J_SIZE=0
BULKHEAD_MCP_SIZE=0
BULKHEAD_WEB_SEARCH_SIZE=0
# 应用级共享 httpx.AsyncClient 连接上限（0 = 每次请求新建 = 基线）
SHARED_HTTP_MAX_CONNECTIONS=0

# Phase H·W4: 持久化与 SSE 批处理（默认 0/false = 关=与基线逐位等价）
# Redis Stream 事件批写：满批即 flush，否则按间隔定时 flush（两键任一 0 = 关；
# 推荐 50/20。注意：开启后 publish→flush 前不可见（可见性延迟 ≤ 间隔））
EVENT_BATCH_MAX_SIZE=0
EVENT_BATCH_FLUSH_MS=0
# 轨迹异步写：record 入队 + 后台 writer 落 sink（关停/测试 flush 兜底）
TRAJECTORY_ASYNC_WRITE_ENABLED=false
# SSE 出口 token 帧 50ms 窗口合并为 delta（HTTP 层，service 帧语义不变）
SSE_COALESCE_ENABLED=false
# SSE 有界队列背压（满丢非关键帧、保终态帧；0 = 关）
SSE_QUEUE_SIZE=0

# Phase 25: Peer 独立预算（镜像 PeerBudget 默认值，防预算失控）
MULTIAGENT_PEER_MAX_STEPS=10
MULTIAGENT_PEER_MAX_MESSAGES=20

# Phase 25: 进程内 asyncio 消息总线（默认关 = 点对点直连现行为）
MULTIAGENT_BUS_ENABLED=false

# Stage F2c A-P2-1: 子代理隔离三件套（ephemeral 任务面 / 摘除父记忆活上下文 /
# 独立 session+budget + 只读记忆快照 + 心跳保活 + live registry kill/pause/steer）
MULTIAGENT_SUBAGENT_ISOLATION_ENABLED=false

# Phase H W5: 子代理结果契约（Peer 黑板面 = 结构化 JSON，证据经 obs:// 外置引用）
SUBAGENT_RESULT_CONTRACT_ENABLED=false
# Phase H W5: 证据充分早停（跳过 reviewer 与后续轮次，复用 information_increment 判据）
MULTIAGENT_EARLY_EXIT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
SERPAPI_KEY=
# Base URL for SerpAPI requests
SERPAPI_BASE_URL=https://serpapi.com/search
# SerpAPI request timeout in seconds
SERPAPI_TIMEOUT=15.0
# Default number of search results to return
SEARCH_RESULT_COUNT=3
NEO4J_DATABASE=neo4j
NEO4J_GRAPH_CACHE_PATH=data/neo4j/graph.json
NEO4J_MAX_CONNECTION_LIFETIME=
NEO4J_BOOTSTRAP_JSON=true
NEO4J_BOOTSTRAP_FORCE=false
# R-P0-4: Neo4j singleton schema refresh interval in seconds (<=0 = first-build only)
NEO4J_SCHEMA_REFRESH_SECONDS=300
# R-P0-4: Cypher execution timeout in seconds (0 = no timeout, baseline behavior)
NEO4J_QUERY_TIMEOUT_SECONDS=0
# Phase H·W2: Cypher cost guard (GraphCostEstimator string precheck; default off = baseline-equal)
NEO4J_COST_GUARD_ENABLED=false
NEO4J_LEGAL_JSON_PATH=data/legal/legal_seed.json
LEGAL_LIGHTRAG_JSON_PATH=data/legal/legal_lightrag_corpus.json
# Max concurrent agent graph executions (semaphore in front of graph.ainvoke)
AGENT_MAX_CONCURRENCY=16
# Phase 15: route non-streaming ask through agentix.agent.AgentLoop (default off = L2 LangGraph)
AGENT_LOOP_ENABLED=false
# Phase 15: RetryReplanner budget for the AgentLoop ask branch (0 = replanner not wired)
AGENT_MAX_REPLANS=0
# F1c: LLM planner for AgentLoop (structured plan, whitelisted tools) + todo_write tool (default off = SingleStepPlanner, no todo_write)
AGENT_LLM_PLANNER_ENABLED=false
# F1d: within-round tool batch concurrency for chat tool loop + AgentLoop (1 = serial baseline-equal; >1 = batch with per-call review preflight, dangerous tools serialized)
AGENT_TOOL_ROUND_CONCURRENCY=1
# F1e: in-loop HITL - suspend review_required in execute_task via langgraph interrupt (approve resumes + one retry) + no-approver REJECT; py3.12+ only (py3.10 degrades), parent HUMAN_REVIEW_ENABLED
HITL_IN_LOOP_ENABLED=false
# T23 (approval-recovery plan, stream-side HITL): when a streamed task hits a tool that needs review,
# emit an `approval` SSE frame so the user can decide inside the stream, then continue (approve + one retry)
# or close at the governance terminal (any other decision = fail-closed).
# Off (default) = stream keeps going L2 without declaring in-loop intent: high-risk tools fail immediately
# and the SSE frame sequence / logs / metrics are byte-for-byte baseline-equal.
# The stream does NOT suspend the graph (a suspended graph has no second response to resume on): the wait
# happens inside the node and the stream keeps emitting `heartbeat` frames, so the approval wait does NOT
# count as STREAM_IDLE_TIMEOUT idle - while AGENT_TIMEOUT wall clock still applies (see 运行时护栏.md).
# Decide through the existing POST /ops/hitl/approvals/{sidecar_request_id} (the gate ledger stays the only
# source of truth). Requires HUMAN_REVIEW_ENABLED=true AND HITL_IN_LOOP_ENABLED=true.
STREAM_HITL_ENABLED=false
# T23 parameter: heartbeat interval (seconds) emitted while the stream waits for an in-stream approval decision.
# Also the granularity of the AGENT_TIMEOUT wall-clock re-check during that wait.
STREAM_HITL_HEARTBEAT_S=15
# T18 (approval-recovery plan, Q7: Postgres is the source of truth): persist HITL pending approvals to the database.
# Off (default) = pending stays in-process memory (FIFO cap 200), table not created, byte-for-byte baseline-equal.
# On = suspend persists to hitl_pending_approvals (db unresolved rows capped at 200 too, overflow refused LOUDLY),
# decision closes the same row, boot-time restore pulls unresolved pendings back, cross-instance decide reads the db (no more 404);
# persist failures are observable (error log + persist_error marker on receipts), never a silent memory-only "success".
# Requires HUMAN_REVIEW_ENABLED=true (wiring happens in install_executor_hook at startup).
HITL_PENDING_PERSIST_ENABLED=false
# T19 (approval-recovery plan, Q9: auto-reject on expiry): approval wait deadline in seconds.
# 0 (default) = off, byte-for-byte baseline-equal: no sweep task created, the SWEEP path never reads the store
# (T18's boot-time restore is not a read added by this card), stats() key set unchanged.
# >0 = a background sweep auto-rejects pendings older than this deadline (fail-closed, same as manual reject) with
# reason=auto_reject_timeout and decided_by=system:deadline, so timeout rejects stay distinguishable from manual ones.
# Counting: `rejected` INCLUDES timeout rejects (an expiry is still a reject); `auto_reject_timeout` is the subset
# broken out by attribution and is NOT added to `decided` (otherwise one decision is counted twice); therefore
# rejection_rate = rejected/decided is not diluted by timeout rejects.
# Metric vocabulary unchanged: still decision="rejected" (six-value closed set); attribution pair is
# retrieval_approval_decisions_total{decision="rejected"} + retrieval_approval_timeouts_total{target_type="tool"}
# (same shape as the retrieval-side approval: one decision metric, plus one timeout metric).
# Scope: "pending lifetime" only. AGENT_TIMEOUT bounds one graph call's wall clock - whichever comes first wins.
# Requires HUMAN_REVIEW_ENABLED=true AND HITL_PENDING_PERSIST_ENABLED=true (no bridge/pending without the former,
# no store to sweep without the latter; if >0 while either is false, or the bridge failed to install, startup logs
# one warning and no task is created).
# Multi-worker deployments (uvicorn --workers 2): only one worker sweeps at a time (DB lease
# hitl_sweep_leases, TTL 120s, taken over on crash) and each pending is decided by exactly one sweeper
# (per-row claim) - see docs/architecture/运行时护栏.md §8.1. The DB row status is the source of truth:
# another worker's decision purges this worker's stale in-memory pending, and a closed row is never re-decided.
HITL_APPROVAL_DEADLINE_S=0
# P3: per-step context rebuild token budget for AgentLoop (0 = one-shot build, baseline-equal)
AGENT_CONTEXT_BUDGET_TOKENS=0
# Phase H·W1: segment token budget for trajectory tool/retrieval observations in ContextPort.build (0 = off; over-budget rows externalize to obs:// refs instead of truncating)
TOOL_OUTPUT_BUDGET_TOKENS=0
# P1: task-type routing (task-query -> execute_task) + task pipeline + write tools (default off)
TASK_EXEC_ENABLED=false
# 恢复期幂等（LG-3-4）：in-loop HITL 挂起后续跑会重跑挂起点之前的步骤；开 = 已完成步骤落
# run_step_ledger（键 thread + checkpoint_ns + 步骤指纹 (tool, 规范化 args) + 序号），
# 同一作用域恢复时跳过、不重放副作用。off（默认）= 不建表、零读写，与基线逐位等价。
# 注意：步骤身份不取模型自拟的 step id（恢复会重新拆解，id 不保证复现）；同一作用域内
# 重复的相同 (tool, args) 步骤按出现序号区分。回滚：DROP TABLE run_step_ledger。
RECOVERY_STEP_LEDGER_ENABLED=false
# Phase 21: progressive skill disclosure — metadata catalog injection + read_skill tool (default off)
SKILLS_ENABLED=false
# Skills root directory (relative to CWD; may point outside the repo)
SKILLS_DIR=skills
# F1b2: AGENTS 级联——指令分层全局(~/.agentix)→项目根→子目录(消息触达) + read_agents_file 按需取回工具（默认关 = build_instructions 与基线逐字节一致）
AGENTS_CASCADE_ENABLED=false
# 上下文工程 B: inject cascaded instruction blocks (AGENTS.md/CLAUDE.md) into the L2 general-query system prompt
# (order: static system constant -> instructions -> memory_context -> history; fingerprint-cached, default off = config untouched)
LG_INSTRUCTIONS_ENABLED=false
# 上下文工程 C: token budget for the L2 history window (0 = off, count-based window only; >0 keeps the newest tail within budget)
LG_TOKEN_HISTORY_BUDGET=0
# 上下文工程 D: append structured status tail (turn/history count/budget remainder) to the latest human message;
# transient only, never in the static prefix (default off)
LG_STATUS_TAIL_ENABLED=false
# Phase 21: lifecycle hooks (on_tool_before/after, on_step_end, on_run_end, on_error) (default off)
HOOKS_ENABLED=false
# Phase 22: L4 semantic auto-compaction when over budget after L1-L3 (last resort, default off)
CONTEXT_AUTOCOMPACT=false
# P3: keep-last window ladder (4->2->1->0) for L4 compaction retries (default off = single attempt)
CONTEXT_COMPACT_LADDER=false
# F1b: real LLM-side tokenizer (tiktoken) for token estimates instead of len//4 (fallback to CJK-aware heuristic; default off = byte-equal estimates)
CONTEXT_REAL_TOKEN_COUNT_ENABLED=false
# F2a: PreCompact 重注——压缩前把关键规则+硬约束重注到上下文尾部（[precompact:*] 审计标记 + meta 来源计数；挂 CONTEXT_AUTOCOMPACT 通道，默认关 = 组装与基线逐字节等价）
CONTEXT_PRECOMPACT_REINJECT_ENABLED=false
# Comma-separated tool names to exclude from get_active_tools()
DISABLED_TOOLS=
# P2: inject configurable.tool_policy (declaration-layer tool visibility filter) into graph config (default off)
TOOL_SELECTION_ENABLED=false
# P2: max_risk_level for the injected ToolSelectionPolicy (L0-L3); NOTE: code_execute declares risk L2, so with TOOL_SELECTION_ENABLED=true the default L1 cap rejects it at the executor-side risk gate ("risk level L2 exceeds policy max L1") — raise to L2/L3 to run code exec
TOOL_SELECTION_MAX_RISK=L1
# P2: comma-separated deferred tools (non-empty declares the tool_search recall tool; empty = resident, baseline-equal)
TOOL_DEFERRED_TOOLS=
# P2: enforce JSON-serializable handler results in ToolExecutor.execute (default off = legacy passthrough)
TOOL_RESULT_CONTRACT_ENABLED=false
# A2b: route the 5 bypassed KG/retrieval tool executions (search/cypher_query/predefined_cypher/microsoft_graphrag_query/text2sql_query) through the ToolExecutor governance chain (default off = node-direct baseline)
TOOL_GATEWAY_ENFORCED=false
# P4: tool guardrails — three-strike failure tiers (warn/block/halt) + identical-result stub (default off = baseline-equal)
TOOL_GUARDRAILS_ENABLED=false
# ---- Phase S：执行边界加固（docs/项目实现手册.md §24.3 T0）----------------
# 全部默认关；不设 = 与加固前逐位等价。
# G1: offload non-coroutine tool handlers to a thread so timeout_ms can actually
#     truncate them (sync handlers otherwise pin the event loop and ignore timeout)
TOOL_SYNC_OFFLOAD_ENABLED=false
# §24.3 T1 ⑧: warn at registration time when a tool handler is not a coroutine
#     function — its timeout_ms binds only if TOOL_SYNC_OFFLOAD_ENABLED is on, so
#     say so at startup instead of letting it surface as a non-cancelling timeout
TOOL_HANDLER_CONTRACT_ENABLED=false
# §24.2 G14: same-name tool re-registration with a DIFFERENT ToolSpec. Off (default) =
#     always log a named `TOOL DUPLICATE REGISTRATION:` warning, but keep the baseline
#     winner (executor keeps the first spec, registry keeps the last) and still swap the
#     handler. On = raise at registration time BEFORE touching the handler (fail-closed).
#     The warning is on regardless: silent spec drops are what G14 is about.
TOOL_DUPLICATE_REGISTRATION_STRICT=false
# §24.3 T2 ⑭ (ADR-0007): honour the per-tool `ToolSpec.sandbox` declaration when picking
#     WHERE a handler runs. Off = never look at the field (byte-equal to pre-T2 behaviour).
#     On: "in_process" (default kind) = exactly today's behaviour, "thread" = always offload
#     to a worker thread, "subprocess"/"container" = REFUSED at the execution point (not yet
#     implemented — they do NOT silently fall back to in-process). Neither implemented kind
#     is an isolation boundary: same process, same GIL, same env vars, same file perms.
EXECUTION_SANDBOX_ENABLED=false
# §24.3 T2 ⑮ (ADR-0007): the third rung of the ladder. OFF (default) = "subprocess" stays
#     in the ladder-minus-implemented gap: declaring it is still REFUSED at the execution
#     point, byte-equal to when ⑭ landed. ON = the tier has an implementation, and then a
#     POSIX capability probe decides whether this machine can actually apply the gates:
#     RLIMIT_AS/CPU/FSIZE + env allowlist + a timeout that can really kill the process group.
#     Probe failure = loud refusal, NEVER a silent downgrade to in-process.
#     The process-count gate (RLIMIT_NPROC, cap 32 tasks) is the one gate with a precondition:
#     it only goes down when TOOL_SANDBOX_SUBPROCESS_UID names a dedicated, non-zero uid,
#     because the kernel charges that limit to the whole real uid across the machine (sharing
#     the parent's uid would false-block or not bind at all) and exempts uid 0, which holds
#     CAP_SYS_RESOURCE. Declined = caps.nproc_gate.applies=false plus one loud warning.
#     Not bought even when on: file permissions and egress are unchanged (read-only root,
#     designated writable dirs and default-deny network belong to T3 ⑰).
TOOL_SANDBOX_SUBPROCESS_ENABLED=false
#     uid the child drops to before running a handler (-1 = keep the parent's uid).
#     Dropping needs privilege in the parent; a non-root container that sets a real uid
#     will get a refusal, not a quietly-ignored declaration. It is ALSO the precondition
#     of the RLIMIT_NPROC gate above: -1 or 0 means that gate stays off, by design.
TOOL_SANDBOX_SUBPROCESS_UID=-1
#     Comma-separated extra env var names allowed into the sandbox child, unioned with the
#     built-in OS allowlist. Deliberately NOT shared with MCP_SUBPROCESS_ENV_EXTRA_KEYS:
#     the allowlist judgement has one source (agentix/domain/tool/exec_env.py), the two
#     audiences do not get to widen each other's wall.
TOOL_SANDBOX_SUBPROCESS_ENV_EXTRA_KEYS=
# code exec（运行时写代码执行任务）：业务总闸。默认关 = 与基线逐位等价（路由不产
#     code-query、code_agent 节点不可达、code_execute 工具零注册）。
#     真正跑起来还需要 EXECUTION_SANDBOX_ENABLED=true + TOOL_SANDBOX_SUBPROCESS_ENABLED=true
#     且运行平台是 POSIX；任一不满足 ⇒ 该次调用失败并说明原因，绝不静默退回进程内执行。
CODE_EXEC_ENABLED=false
# 总尝试轮数上限（含首次执行）：运行层失败（退出码非零 / 超时）把输出喂回下一轮改码，
#     最多尝试这么多轮（含第一次）；轮数用尽 ⇒ 产出失败回执（含最后一次输出），不假装成功。
#     治理层失败不进这个循环。
CODE_EXEC_MAX_ROUNDS=3
# 单次代码执行超时（秒）；工具契约里 timeout_s 的取值域是 1–120 秒
CODE_EXEC_TIMEOUT_S=20
# G2: scrub the MCP stdio subprocess environment down to an OS-critical allowlist,
#     instead of inheriting every secret in the parent process
MCP_SUBPROCESS_ENV_SCRUB=false
# G2: comma-separated extra env var names allowed into MCP subprocesses when scrub is on
MCP_SUBPROCESS_ENV_EXTRA_KEYS=
# G11: override SQLAlchemy engine echo; leave empty to keep the legacy DEBUG-derived value
#      (echo dumps full SQL + parameters into stdlib logging, bypassing loguru)
DB_ECHO=
# G6: explicit environment identity (development|staging|production); leave empty to keep
#     the legacy DEBUG-derived inference. Production deployments MUST set this.
APP_ENV=
# G6: override uvicorn hot-reload; leave empty to follow DEBUG.
UVICORN_RELOAD=
# §24.3 T1 ⑪: enforce tenant ownership on GET /settings/{kb_id} and admin role on PUT.
#     Off = any authenticated user can read AND REWRITE any kb_id's model config, incl.
#     llm_base_url (point a victim tenant's prompts at your own endpoint).
#     Turning it on requires BOTH: migrations have backfilled knowledgebase.tenant_id,
#     and the tenant actually has an admin account (register always creates 'member' and
#     there is no self-service promotion API) — otherwise the settings page is 403.
#     See docs/runbooks/预发环境与配置矩阵.md "设置接口授权收紧".
SETTINGS_AUTHZ_ENABLED=false
# P4: RollbackPort-backed enter/exit_plan_mode plan-mode permission switch (default off)
AGENT_ROLLBACK_ENABLED=false
# P4: persist a durable assistant boundary before publishing a failed turn (excludes context_overflow; default off)
FAILURE_BOUNDARY_ENABLED=false
# P5: background cron scheduler loop + cron_create/list/delete/run tool family (default off)
CRON_ENABLED=false
# Cron scheduler tick interval in seconds (used only when CRON_ENABLED=true)
CRON_TICK_SECONDS=60
# T26: Redis Stream task-queue consumer worker (default off = no task, no connection, baseline-identical).
# On = consumes agentix:tasks and takes over stuck PEL entries of dead consumers via XAUTOCLAIM
# (idle >= 60s, one round per 30s, <= 16 messages per round; those three are module constants in
# task_queue.py, deliberately NOT config keys). Requires Redis >= 6.2 (XAUTOCLAIM); the repo compose
# image redis/redis-stack-server:7.4.0-v2 satisfies it. Shutdown: stop_worker() + cancel in _shutdown.
TASK_QUEUE_WORKER_ENABLED=false
KB_DATA_FILE=data/kb/legal_corpus.txt
# Max candidates for kb_ingest reranker when enabled
KB_RERANK_MAX_CANDIDATES=20
# Top N results returned by kb_ingest reranker
KB_RERANK_TOP_N=6
# Timeout for kb_ingest reranker requests
KB_RERANK_TIMEOUT=30
# Score fusion alpha for kb_ingest reranker
KB_RERANK_SCORE_FUSION_ALPHA=0.5
# Root directory for uploaded files/images (relative paths resolve against CWD)
UPLOAD_DIR=uploads
# External HTTP endpoint for KB fallback search (e.g., http://localhost:8000/api/search)
KB_EXTERNAL_SEARCH_URL=
# Timeout in seconds for external KB search requests.
KB_EXTERNAL_SEARCH_TIMEOUT=20.0
# 检索通道瞬时故障重试（P0-2(a) 接线）：单次检索最多尝试次数（含首次）
KB_RETRIEVAL_MAX_ATTEMPTS=2
# 检索通道瞬时故障重试（P0-2(a) 接线）：指数退避基础延迟（秒）
KB_RETRIEVAL_RETRY_BASE_DELAY=0.25
