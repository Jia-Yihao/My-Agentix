# ============================================================================
# My Agentix 环境配置分层 —— 开发环境差异项（P1 部署收口）
#
# 用法：以 `.env.example` 为母本复制为 `.env`，再用本文件的差异项覆盖。
# 本文件只列「与母本默认值不同或必须显式确认」的配置；未列出的项沿用母本。
# ============================================================================

# ---------- 应用基础 ----------
APP_NAME=My Agentix
DEBUG=True                      # 开发：开调试（uvicorn --reload 由 compose command 按 DEBUG 分支）
REQUIRE_API_KEY=false           # 开发：本机联调可不启用 API Key 认证
SECRET_KEY=                     # 开发可留空（JWT 走不安全降级，勿带出本机）

# ---------- 限流（开发默认关，避免本机压测被拦） ----------
RATE_LIMIT_ENABLED=false

# ---------- 观测（开发：console 导出便于排查） ----------
OTEL_EXPORTER_OTLP_ENDPOINT=    # 开发默认不接 collector
OTEL_CONSOLE_EXPORT=true

# ---------- 初始化类（开发：跳过构建期/启动期重初始化） ----------
INIT_LIGHTRAG_ON_BUILD=false

# ---------- 编排资源（开发：降配，省内存） ----------
RETRIEVAL_WORKER_REPLICAS=1
RETRIEVAL_WORKER_CPUS=1.0
RETRIEVAL_WORKER_MEMORY=2g
